# Google AI Studio (Gemini). A Studio API key works here — same key as https://aistudio.google.com/apikey
AI_PROVIDER=google
AI_MODEL=gemini-3.6-flash
AI_API_KEY=
# GOOGLE_API_KEY= is also accepted if AI_API_KEY is empty.

# Optional B2 S3-compatible analytical mart storage.
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Optional Supabase PostgreSQL sales-workflow storage.
DATABASE_URL=