# AI Provider Configuration
# Options: gemini (or google), claude, or leave empty for auto-detection
AI_PROVIDER=gemini

# Fallback order (comma-separated) - providers will be tried in this order
# Note: "google" is accepted as an alias for "gemini"
AI_FALLBACK_ORDER=gemini,claude

# Model selection (provider-specific defaults shown)
AI_MODEL=gemini-3.6-flash

# Google AI Studio (Gemini) API Key
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Alternative: AI_API_KEY= is also accepted for Gemini

# Anthropic (Claude) API Key
# Get your key from: https://console.anthropic.com/
CLAUDE_API_KEY=
# Alternative: ANTHROPIC_API_KEY= is also accepted for Claude

# Optional B2 S3-compatible analytical mart storage.
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Optional Supabase PostgreSQL sales-workflow storage.
DATABASE_URL=